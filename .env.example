# Copy this file to .env at the repository root and fill it in. .env is ignored by git.
# The scripts under infra/ load it; a variable already set in the shell wins over the file.

# --- Azure CLI profile and target ---------------------------------------------------------------
# Isolated Azure CLI profile folder, so this tenant's tokens stay apart from your other logins.
# Windows example: C:\.AzureCliProfiles\my-lab\.azure     Linux/macOS example: /home/me/.azure-profiles/my-lab
AZURE_CONFIG_DIR=
# The scripts refuse to run against any other tenant or subscription.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# --- Shared Foundry (infra/shared-foundry) ------------------------------------------------------
# Region of the shared account. When empty, the region in model-plan.json is used.
SHARED_FOUNDRY_LOCATION=swedencentral
# Comma-separated Microsoft Entra object IDs that receive the Foundry User role on the account.
# When both are empty, the deploy script uses the signed-in user.
SHARED_FOUNDRY_USER_OBJECT_IDS=
SHARED_FOUNDRY_GROUP_OBJECT_IDS=
# Comma-separated public IPv4 addresses or CIDR ranges allowed to call the endpoints.
# Empty allows all networks; Microsoft Entra authentication is still required.
SHARED_FOUNDRY_ALLOWED_IP_RANGES=
# Optional Log Analytics workspace resource ID for an own diagnostic setting on the account.
SHARED_FOUNDRY_LOG_ANALYTICS_WORKSPACE_ID=
# Set to false to turn off the anonymous usage telemetry of the Azure Verified Modules.
SHARED_FOUNDRY_ENABLE_TELEMETRY=true
