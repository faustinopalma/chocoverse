.create-merge table bronze_lab (event_id:string, run_id:string, seq:long, sim_ts:datetime, wall_ts:datetime, event_type:string, payload:dynamic, raw_event:string)
.create-merge table bronze_business (event_id:string, run_id:string, sequence:long, sim_ts:datetime, wall_ts:datetime, event_type:string, event:dynamic, raw_event:string)
.create-or-alter table bronze_business ingestion json mapping 'business_json' '[{"column":"event_id","Properties":{"Path":"$.event_id"}},{"column":"run_id","Properties":{"Path":"$.run_id"}},{"column":"sequence","Properties":{"Path":"$.sequence"}},{"column":"sim_ts","Properties":{"Path":"$.sim_ts"}},{"column":"wall_ts","Properties":{"Path":"$.wall_ts"}},{"column":"event_type","Properties":{"Path":"$.event_type"}},{"column":"event","Properties":{"Path":"$.event"}},{"column":"raw_event","Properties":{"Path":"$.raw_event"}}]'
