let end_month = toscalar(bronze_business
    | where run_id == "business-demo-001" and event_type == "world.business.observed"
    | summarize max(startofmonth(todatetime(event.simlocaldate))));
bronze_business
| where run_id == "business-demo-001" and event_type == "finance.ledger.posted"
| where todatetime(event.simlocaldate) < end_month
| summarize take_any(*) by event_id
| extend amount_eur=todouble(event.data.amount_cents)/100.0, posting=tostring(event.data.posting_type)
| summarize revenue_eur=sumif(amount_eur, posting in ("retail.cash.received", "finance.sales.invoice")),
    purchases_eur=sumif(amount_eur, posting == "finance.purchase.invoice"),
    conversion_eur=sumif(amount_eur, posting == "finance.conversion.paid")
    by sim_month=startofmonth(todatetime(event.simlocaldate))
| order by sim_month asc
